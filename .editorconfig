root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Firmware sources: keep CRLF for Keil. All sources are UTF-8; text sent to
# SYN6288 / OLED font keys must be GBK bytes written as \x escapes (tools/fix_encoding.py).
[*.{c,h,s}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{sh,py,md,yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2
